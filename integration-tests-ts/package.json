{
  "name": "sweat-near-integration-tests",
  "private": true,
  "version": "1.0.0",
  "description": "TypeScript integration tests for sweat-near using near-workspaces-js + AVA",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "ava"
  },
  "devDependencies": {
    "@ava/typescript": "^5.0.0",
    "@types/node": "^22.10.0",
    "ava": "^7.0.0",
    "near-workspaces": "^5.0.0",
    "typescript": "^5.6.0"
  },
  "ava": {
    "failFast": false,
    "timeout": "5m",
    "typescript": {
      "rewritePaths": {
        "src/": "build/"
      },
      "compile": "tsc"
    },
    "files": [
      "src/**/*.ava.ts"
    ]
  }
}
